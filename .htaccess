# Portal do Sistema de Gestão — ZEUS TECH
# Os documentos NÃO estão aqui: ficam fora da pasta pública e só saem pelo doc.php.

Options -Indexes

# Ficheiros internos nunca são servidos directamente
<FilesMatch "^(_config|_sessao)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|b64|md|log)$">
  Require all denied
</FilesMatch>

# Forçar https
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>

DirectoryIndex index.php
